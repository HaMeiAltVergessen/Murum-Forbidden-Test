[sub_resource type="Resource" id="Resource_entry1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Der Weg widerspricht sich."
text_speed = 24.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Wie du."
text_speed = 20.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Jaja, alles irgendwo bedeutungslos."
text_speed = 26.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Und doch gehst du."
text_speed = 22.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Die Richtung ändert sich, vorwärts komm ich nicht."
text_speed = 26.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Der Ort spiegelt dich."
text_speed = 22.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry7"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Oder ich ihm."
text_speed = 20.0
choices = Array[ExtResource("2_6f78r")]([])

[sub_resource type="Resource" id="Resource_entry8"]
script = ExtResource("2_entry")
