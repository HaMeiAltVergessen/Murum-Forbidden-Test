[sub_resource type="Resource" id="Resource_entry1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Der Tempel ist immer noch leer. Nur die natürlichen Zeugnisse des Verfalls."
text_speed = 28.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Du hast ihn geleert."
text_speed = 24.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe diese Welt bewahrt."
text_speed = 24.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Vor einem Wesen, das sich selbst Götter nannte."
text_speed = 26.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Surus war mal anders."
text_speed = 22.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Vor dem Wahnsinn, denn du entfesselt hast."
text_speed = 26.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry7"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe ihn aufgehalten."
text_speed = 22.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry8"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Du hast ihn erschlagen."
text_speed = 24.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry9"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Bevor er diese Welt zerriss."
text_speed = 24.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry10"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Und niemand weiß, dass du es warst."
text_speed = 26.0
choices = Array[ExtResource("2_edpe1")]([])

[sub_resource type="Resource" id="Resource_entry11"]
