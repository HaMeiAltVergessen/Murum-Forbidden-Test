[gd_resource type="Resource" script_class="DialogData" load_steps=22 format=3 uid="uid://eremit_dialog_coop"]

[ext_resource type="Script" path="res://resources/dialog/dialog_data.gd" id="1_data"]
[ext_resource type="Script" path="res://resources/dialog/dialog_entry.gd" id="2_entry"]
[ext_resource type="Script" path="res://resources/dialog/dialog_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Resource_entry1"]
script = ExtResource("2_entry")
speaker_name = ""
speaker_sprite = null
text = "Eine Gestalt steht reglos vor dem Tempeltor. Der Wind zerrt an seinem zerfetzten Umhang."
text_speed = 28.0
choices = []

[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Der Eremit"
speaker_sprite = null
text = "Ich bin hier. Und ich habe den Schlüssel."
text_speed = 22.0
choices = []

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = "Lythrun"
speaker_sprite = null
text = "Noch ein Bekannter. Du bist ja großartig mit Personen aus der Vergangenheit."
text_speed = 26.0
choices = []

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Murum"
speaker_sprite = null
text = "Gibst du ihn mir?"
text_speed = 22.0
choices = []

[sub_resource type="Resource" id="Resource_entry5"]
script = ExtResource("2_entry")
speaker_name = "Der Eremit"
speaker_sprite = null
text = "Nein."
text_speed = 18.0
choices = []

[sub_resource type="Resource" id="Resource_entry5b"]
script = ExtResource("2_entry")
speaker_name = "Lythrun"
speaker_sprite = null
text = "Das war absehbar."
text_speed = 24.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry1"]
script = ExtResource("2_entry")
speaker_name = "Der Eremit"
speaker_sprite = null
text = "Damals wusste ich weder wer, noch was du bist."
text_speed = 24.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry2"]
script = ExtResource("2_entry")
speaker_name = "Der Eremit"
speaker_sprite = null
text = "Jetzt weiß ich es. Und deshalb kann ich dich nicht passieren lassen."
text_speed = 24.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry2b"]
script = ExtResource("2_entry")
speaker_name = "Lythrun"
speaker_sprite = null
text = "Ich seh es schon kommen. Mach dich bereit, Murum."
text_speed = 24.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
speaker_sprite = null
text = "Ich will nicht kämpfen."
text_speed = 22.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry4"]
script = ExtResource("2_entry")
speaker_name = "Der Eremit"
speaker_sprite = null
text = "Was du willst, spielt keine Rolle mehr. Es ist Schicksal."
text_speed = 24.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry5"]
script = ExtResource("2_entry")
speaker_name = "Lythrun"
speaker_sprite = null
text = "Unausweichlich. Wie immer."
text_speed = 22.0
choices = []

[sub_resource type="Resource" id="Resource_deep_entry6"]
script = ExtResource("2_entry")
speaker_name = ""
speaker_sprite = null
text = "Der Eremit hebt seinen Stab. Es gibt kein Zurück."
text_speed = 26.0
choices = []

