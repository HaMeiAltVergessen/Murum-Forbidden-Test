[sub_resource type="Resource" id="Resource_entry1"]
script = ExtResource("2_entry")
speaker_name = ""
text = "Gedämpftes Licht. Der Raum wirkt älter als das Dorf."
text_speed = 28.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Frau"
text = "Er ist es."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Der, der uns hier festhält."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ihr lebt."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry5"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Definition ist alles."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Der Kreis ist stabil."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e2"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Stabil?
Wir hören den Tag nicht enden."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e3"]
script = ExtResource("2_entry")
speaker_name = "Frau"
text = "Wir schlafen, ohne zu wachen."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e4"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Das ist Erhaltung."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e5"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Nicht Leben."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e1"]
script = ExtResource("2_entry")
speaker_name = "Frau"
text = "Zeit bleibt draußen."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e2"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Tod auch."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e3"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Und Hoffnung."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e4"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Hoffnung ist instabil.
Sie hätte den Kreis gebrochen."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e5"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Wie praktisch."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Dann habt ihr den Kern erfasst."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e2"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Du hast entschieden, dass wir bleiben."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe entschieden, dass ihr nicht endet."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e4"]
script = ExtResource("2_entry")
speaker_name = "Frau"
text = "Das ist dasselbe."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Nein.
Ende ist Veränderung."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Und Veränderung ist sein Feind."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Schnell."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e2"]
script = ExtResource("2_entry")
speaker_name = "Frau"
text = "Gemeinsam."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Unkontrolliert."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e4"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Du hast uns Zeit gekauft."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Nein.
Ich habe den Moment eingefroren."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Für immer ist ein langer Augenblick."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Fragen verzerren Entscheidungen."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e2"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Du hast uns benutzt."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe euch fixiert.
Damit etwas anderes nicht zerfällt."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e4"]
