text = "Etwas?"
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Jemand."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Er sagt es nicht."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c6_e1"]
script = ExtResource("2_entry")
speaker_name = "Frau"
text = "Nichts beginnt."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c6_e2"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Dann erfüllt der Kreis seine Funktion."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c6_e3"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Du nennst das Funktion."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c6_e4"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ja."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c6_e5"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Nicht Würde."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c7_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich kann es nicht."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c7_e2"]
script = ExtResource("2_entry")
speaker_name = "Mann"
text = "Warum?"
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c7_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Weil ich nur zerstöre.
Und ihr nicht sterben dürft."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c7_e4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Das ist seine Strafe."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

