[sub_resource type="Resource" id="Resource_c1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Zwinge mich nicht."
text_speed = 20.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2"]
script = ExtResource("2_entry")
speaker_name = "Geist-Murum"
text = "Es nicht Alyria, sondern?"
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Myrkur."
text_speed = 18.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4"]
script = ExtResource("2_entry")
speaker_name = "Geist-Murum"
text = "Das was hinter der Pforte lag?"
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Das was in Urgathon war. Es darf niemals das Auge von Xy erhalten."
text_speed = 26.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Und braucht ihn dafür."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice_c"]
script = ExtResource("3_choice")
choice_text = "Vor wem?"
