[sub_resource type="Resource" id="Resource_intro1"]
script = ExtResource("2_entry")
speaker_name = ""
text = "Der Blick öffnet sich auf die Ruinen. Der Wind trägt Asche.
Eine Gestalt – Murum, wie er war – steht reglos am Rand."
text_speed = 28.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_intro2"]
script = ExtResource("2_entry")
speaker_name = "Geist-Murum"
text = "Hier hat es aufgehört, still zu sein."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_intro3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Hier wurde es notwendig."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_intro4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Er nennt es immer so."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_a1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Zögern verlängert Leid."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_a2"]
script = ExtResource("2_entry")
speaker_name = "Geist-Murum"
text = "Du hast etwas in sie gelegt."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_a3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe etwas aus ihr entfernt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_a4"]
script = ExtResource("2_entry")
speaker_name = "Geist-Murum"
text = "Und sie zerbrach trotzdem."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_a5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ja."
text_speed = 18.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_a6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Zerstörung ist kein Versprechen."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice_a"]
script = ExtResource("3_choice")
choice_text = "Was ist hier geschehen?"
response_speaker = "Geist-Murum"
response_text = "Die Welt hat gezögert.
Und ich habe entschieden."
next_entries = Array[ExtResource("2_entry")]([SubResource("Resource_a1"), SubResource("Resource_a2"), SubResource("Resource_a3"), SubResource("Resource_a4"), SubResource("Resource_a5"), SubResource("Resource_a6")])

[sub_resource type="Resource" id="Resource_b1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Etwas, das niemand sehen darf."
text_speed = 22.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_b2"]
script = ExtResource("2_entry")
speaker_name = "Geist-Murum"
