[sub_resource type="Resource" id="Resource_entry1"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Ich habe gehofft, du würdest mich nicht mehr erkennen."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich vergesse nichts, was mir gefolgt ist."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Dann weißt du, wer ich war."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Und was er nicht geworden ist."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Sprechen ist kein Zeichen von Leben."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e2"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Die anderen haben geschrien.
Oder sind verstummt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Sie wollten sehen.
Ich habe ihnen eine Wahrheit gezeigt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e4"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Du hast die Tür geöffnet."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Nein.
Ich habe sie sichtbar gemacht."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c1_e6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Oh führe sie nicht Versuchung…."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
choice_text = "Du warst mein Schüler."
response_speaker = "Alter Mann"
response_text = "Einer von vielen.
Doch ich bin der Einzige, der noch spricht."
next_entries = Array[ExtResource("2_entry")]([SubResource("Resource_c1_e1"), SubResource("Resource_c1_e2"), SubResource("Resource_c1_e3"), SubResource("Resource_c1_e4"), SubResource("Resource_c1_e5"), SubResource("Resource_c1_e6")])

[sub_resource type="Resource" id="Resource_c2_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Du hast sie gesehen."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e2"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Ja.
Und ich habe mich abgewandt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Du warst mein klügster Schüler."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e4"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Mag sein."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Du hast du richtig gehandelt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e6"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Nein.
Ich habe mich verdammt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c2_e7"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Der einzige Akt von Macht hier."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
choice_text = "Warum lebst du noch?"
response_speaker = "Alter Mann"
response_text = "Weil ich nie hindurchgegangen bin.
Zur Pforte."
next_entries = Array[ExtResource("2_entry")]([SubResource("Resource_c2_e1"), SubResource("Resource_c2_e2"), SubResource("Resource_c2_e3"), SubResource("Resource_c2_e4"), SubResource("Resource_c2_e5"), SubResource("Resource_c2_e6"), SubResource("Resource_c2_e7")])

[sub_resource type="Resource" id="Resource_c3_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Sie waren unvollständig."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e2"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Und du?"
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich bin vollständig.
Darum zerstöre ich."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e4"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Du hast sie geopfert."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe sie vorbereitet.
Auf das, was kommt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c3_e6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Niemand ist je bereit."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice3"]
script = ExtResource("3_choice")
choice_text = "Was ist aus den anderen geworden?"
response_speaker = "Alter Mann"
response_text = "Sie dachten, Erkenntnis würde sie vervollständigen.
Aber sie hat sie entleert."
next_entries = Array[ExtResource("2_entry")]([SubResource("Resource_c3_e1"), SubResource("Resource_c3_e2"), SubResource("Resource_c3_e3"), SubResource("Resource_c3_e4"), SubResource("Resource_c3_e5"), SubResource("Resource_c3_e6")])

[sub_resource type="Resource" id="Resource_c4_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Sprich es aus."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e2"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Du kannst nichts erschaffen.
Du bist das Ende jeder Kette."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Korrekt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e4"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Und trotzdem folgten sie dir."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Weil Enden klar sind.
Anfänge lügen."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c4_e6"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Deshalb braucht er sie."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice4"]
script = ExtResource("3_choice")
choice_text = "Warum hast du Nein gesagt?"
response_speaker = "Alter Mann"
response_text = "Weil ich gesehen habe, was du bist."
next_entries = Array[ExtResource("2_entry")]([SubResource("Resource_c4_e1"), SubResource("Resource_c4_e2"), SubResource("Resource_c4_e3"), SubResource("Resource_c4_e4"), SubResource("Resource_c4_e5"), SubResource("Resource_c4_e6")])

[sub_resource type="Resource" id="Resource_c5_e1"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Ich habe nichts versprochen."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e2"]
script = ExtResource("2_entry")
speaker_name = "Alter Mann"
text = "Doch.
Nicht mit Worten."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
text = "Dann haben sie sie gespürt."
text_speed = 24.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_c5_e4"]
