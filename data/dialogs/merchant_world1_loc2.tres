choices = []

[sub_resource type="Resource" id="Resource_b2"]
script = ExtResource("2_entry")
speaker_name = "Lindro"
speaker_sprite = null
text = "Du erinnerst dich."
text_speed = 22.0
choices = []

[sub_resource type="Resource" id="Resource_b3"]
script = ExtResource("2_entry")
speaker_name = "Murum"
speaker_sprite = null
text = "Flammen.\nUnd Finsternis."
