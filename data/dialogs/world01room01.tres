[sub_resource type="Resource" id="Resource_choice2"]
script = ExtResource("3_choice")
choice_text = "[Schweigen]"

[sub_resource type="Resource" id="Resource_entry5"]
script = ExtResource("2_entry")
speaker_name = "Murum"
speaker_sprite = null
text = "Es muss immer noch hier sein."
text_speed = 22.0
choices = [SubResource("Resource_choice1"), SubResource("Resource_choice2")]

[resource]
