[sub_resource type="Resource" id="Resource_entry1"]
script = ExtResource("2_entry")
speaker_name = ""
speaker_sprite = null
text = "Ein kalter Schatten zieht an deiner Seite entlang. Du spürst eine vertraute Präsenz."
text_speed = 30.0
choices = []

[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
speaker_sprite = null
text = "Murum... Warum kehrst du zurück? Diese Ruinen sollten für immer hinter dir liegen."
text_speed = 28.0
choices = []

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = ""
speaker_sprite = null
text = "Du schweigst. Die Worte deines Schattens hallen in der Stille nach."
text_speed = 30.0
choices = []

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
speaker_sprite = null
text = "Du weichst aus. Wie immer."
text_speed = 25.0
choices = []

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("3_choice")
