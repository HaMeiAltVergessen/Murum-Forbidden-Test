[sub_resource type="Resource" id="Resource_entry2"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Murum... Warum kehrst du zurück? Diese Ruinen sollten für immer hinter dir liegen."
text_speed = 28.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry3"]
script = ExtResource("2_entry")
speaker_name = ""
text = "Du schweigst. Die Worte deines Schattens hallen in der Stille nach."
text_speed = 30.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_entry4"]
script = ExtResource("2_entry")
speaker_name = "Umbra"
text = "Du weichst aus. Wie immer."
text_speed = 25.0
choices = Array[ExtResource("3_choice")]([])

[sub_resource type="Resource" id="Resource_choice1"]
