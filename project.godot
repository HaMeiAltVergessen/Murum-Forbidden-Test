; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Murum - Forbidden Tales"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://core/autoloads/game_manager.gd"
EventBus="*res://core/autoloads/event_bus.gd"
AudioManager="*res://core/autoloads/audio_manager.gd"
CombatManager="*res://core/autoloads/combat_manager.gd"
GlobalTimeEffects="*res://core/autoloads/global_time_effects.gd"
SettingsManager="*res://core/autoloads/settings_manager.gd"
SaveManager="*res://core/autoloads/save_manager.gd"
WorldManager="*res://core/autoloads/world_manager.gd"
InventoryManager="*res://core/autoloads/inventory_manager.gd"
ShopManager="*res://core/autoloads/shop_manager.gd"
InputManager="*res://core/autoloads/input_manager.gd"
InputRemappingManager="*res://systems/input/input_remapping_manager.gd"
CoopManager="*res://core/autoloads/coop_manager.gd"
HUDManager="*res://core/autoloads/hud_manager.gd"
StatisticsManager="*res://core/autoloads/statistics_manager.gd"
AchievementManager="*res://core/autoloads/achievement_manager.gd"
ChallengeRunManager="*res://core/autoloads/challenge_run_manager.gd"
InventoryUI="*res://ui/inventory/inventory.tscn"
HUD="*res://ui/hud.tscn"
PauseMenu="*res://ui/menus/pause_menu.tscn"
CutsceneManager="*res://systems/cutscene/cutscene_manager.gd"
DialogManager="*res://systems/dialog/dialog_manager.tscn"
MusicScenePlayer="*res://core/autoloads/music_scene_player.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"

